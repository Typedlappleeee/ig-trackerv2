{
  "functions": {
    "api/geelark.js": { "maxDuration": 30 },
    "api/gx.js":      { "maxDuration": 30 },
    "api/rotate.js":  { "maxDuration": 15 },
    "api/cron.js":    { "maxDuration": 60 },
    "api/iremotech.js": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/cron", "schedule": "* * * * *" }
  ],
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "installCommand": "npm install --legacy-peer-deps",
  "framework": null,
  "headers": [
    {
      "source": "/ffmpeg/(.*)",
      "headers": [
        { "key": "Cross-Origin-Resource-Policy", "value": "cross-origin" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/ffmpeg/ffmpeg-core.wasm",
      "headers": [
        { "key": "Content-Type", "value": "application/wasm" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/((?!api/|ffmpeg/|assets/).*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/((?!api/|ffmpeg/|assets/).*)", "destination": "/index.html" }
  ]
}
