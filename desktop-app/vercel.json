{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/geelark-upload.js": { "maxDuration": 60 },
    "api/groq.js": { "maxDuration": 60 },
    "api/iremotech.js": { "maxDuration": 60 },
    "api/geelark.js": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/((?!api/|assets/|ffmpeg/|.*\\.).*)", "destination": "/index.html" }
  ]
}
