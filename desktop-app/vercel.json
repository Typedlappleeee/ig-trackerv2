{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/geelark-upload.js": {
      "maxDuration": 60
    },
    "api/groq.mjs": {
      "maxDuration": 60
    },
    "api/fivesim.mjs": {
      "maxDuration": 30
    },
    "api/herosms.mjs": {
      "maxDuration": 30
    },
    "api/iremotech.js": {
      "maxDuration": 60
    },
    "api/iremotech-stream.js": {
      "maxDuration": 60
    },
    "api/meta-callback.js": {
      "maxDuration": 15
    },
    "api/rotate.js": {
      "maxDuration": 15
    },
    "api/geelark.js": {
      "maxDuration": 30
    },
    "api/l.js": {
      "maxDuration": 10
    },
    "api/v1.js": {
      "maxDuration": 60
    },
    "api/link.js": {
      "maxDuration": 60
    },
    "api/v1-tools.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/ffmpeg-static/ffmpeg"
    }
  },
  "rewrites": [
    {
      "source": "/:code([a-z0-9][a-z0-9-]+)",
      "has": [
        {
          "type": "host",
          "value": "tapmylink.fr"
        }
      ],
      "destination": "/api/l?p=:code"
    },
    {
      "source": "/:code([a-z0-9][a-z0-9-]+)",
      "has": [
        {
          "type": "host",
          "value": "www.tapmylink.fr"
        }
      ],
      "destination": "/api/l?p=:code"
    },
    {
      "source": "/l/:path*",
      "destination": "/api/l?p=:path*"
    },
    {
      "source": "/api/v1/tools",
      "destination": "/api/v1-tools"
    },
    {
      "source": "/api/v1/tools/:tool",
      "destination": "/api/v1-tools?tool=:tool"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "/api/v1?r=:path*"
    },
    {
      "source": "/genjutsu",
      "destination": "https://generateur-prompts.vercel.app/"
    },
    {
      "source": "/genjutsu/:path*",
      "destination": "https://generateur-prompts.vercel.app/:path*"
    },
    {
      "source": "/api/hf",
      "destination": "https://generateur-prompts.vercel.app/api/hf"
    },
    {
      "source": "/api/claude",
      "destination": "https://generateur-prompts.vercel.app/api/claude"
    },
    {
      "source": "/api/collecte",
      "destination": "https://generateur-prompts.vercel.app/api/collecte"
    },
    {
      "source": "/api/mg",
      "destination": "https://generateur-prompts.vercel.app/api/mg"
    },
    {
      "source": "/api/transcrire",
      "destination": "https://generateur-prompts.vercel.app/api/transcrire"
    },
    {
      "source": "/fonts/:path*",
      "destination": "https://generateur-prompts.vercel.app/fonts/:path*"
    },
    {
      "source": "/((?!api/|assets/|ffmpeg/|.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
