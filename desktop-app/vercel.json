{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/geelark-upload.js": {
      "maxDuration": 60
    },
    "api/groq.mjs": {
      "maxDuration": 60
    },
    "api/fivesim.mjs": {
      "maxDuration": 30
    },
    "api/herosms.mjs": {
      "maxDuration": 30
    },
    "api/iremotech.js": {
      "maxDuration": 60
    },
    "api/iremotech-stream.js": {
      "maxDuration": 60
    },
    "api/meta-callback.js": {
      "maxDuration": 15
    },
    "api/rotate.js": {
      "maxDuration": 15
    },
    "api/geelark.js": {
      "maxDuration": 30
    },
    "api/l.js": {
      "maxDuration": 10
    },
    "api/v1.js": {
      "maxDuration": 60
    },
    "api/link.js": {
      "maxDuration": 60
    },
    "api/v1-tools.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/ffmpeg-static/ffmpeg"
    }
  },
  "rewrites": [
    {
      "source": "/:code([a-z0-9][a-z0-9-]+)",
      "has": [
        {
          "type": "host",
          "value": "tapmylink.fr"
        }
      ],
      "destination": "/api/l?p=:code"
    },
    {
      "source": "/:code([a-z0-9][a-z0-9-]+)",
      "has": [
        {
          "type": "host",
          "value": "www.tapmylink.fr"
        }
      ],
      "destination": "/api/l?p=:code"
    },
    {
      "source": "/l/:path*",
      "destination": "/api/l?p=:path*"
    },
    {
      "source": "/api/v1/tools",
      "destination": "/api/v1-tools"
    },
    {
      "source": "/api/v1/tools/:tool",
      "destination": "/api/v1-tools?tool=:tool"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "/api/v1?r=:path*"
    },
    {
      "source": "/((?!api/|assets/|ffmpeg/|.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
