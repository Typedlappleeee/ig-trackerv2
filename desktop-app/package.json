{
  "name": "scaleflow-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "ScaleFlow — automatisation Instagram & TikTok multi-comptes",
  "author": "ScaleFlow",
  "repository": "https://github.com/Typedlappleeee/ig-trackerv2",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "dist": "vite build && electron-builder"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "typescript": "^5.5.3",
    "vite": "^5.4.1"
  },
  "build": {
    "appId": "com.scaleflow.desktop",
    "productName": "ScaleFlow",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*"],
    "icon": "build/icon.png",
    "publish": null,
    "win": { "target": ["nsis"], "icon": "build/icon.png", "artifactName": "ScaleFlow-Setup-${version}.${ext}" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
